# Git files
.git
.gitignore
.github

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# Results and logs
.research/results/**
# ...but not the two things a run needs to resume or to avoid redundant work.
# Excluding these is what made a run recompute 212 systems whose checkpoints
# were already committed, and re-run every MSA search that was already
# archived. Bulk results stay out; the resume data comes in.
!.research/results/_msa/**
!.research/results/*/systems/**
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.pem
*.key
